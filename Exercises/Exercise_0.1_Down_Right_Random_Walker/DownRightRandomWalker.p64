:: Walker.lua
--[[pod_format="raw",created="2024-10-02 15:06:36",modified="2025-01-03 15:37:25",revision=319]]

function Walker()
	Walker = {xPosition = screenWidth/2, yPosition = screenHeight/2, colour = 7}
	return Walker
end

function step()
	choice = flr(rnd(13))
	
	if choice >= 0 and choice <= 5 then
		Walkers[1].xPosition += 1 --right
	elseif choice == 1 then
		Walkers[1].xPosition -= 1 --left
	elseif choice > 5 and choice <= 10 then
		Walkers[1].yPosition += 1 --down
	else 
		Walkers[1].yPosition -= 1 --up
	end
end
:: main.lua
--[[pod_format="raw",created="2024-10-02 14:56:10",modified="2025-01-03 15:37:25",revision=351]]
include "Walker.lua"

screenWidth = 480
screenHeight = 270
Timer = 0


Walkers = {}
function _init()
	add(Walkers,Walker())
end

function _update()
	step()
	if Timer % 60 == 0 then
		Walkers[1].colour += 1
		if Walkers[1].colour > 15 then
			Walkers[1].colour = 7
		end
	end
	Timer += 1
end

function _draw()
	circfill(Walkers[1].xPosition, Walkers[1].yPosition, 0, Walkers[1].colour)
end
